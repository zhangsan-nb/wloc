{
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --no-autoconfig -c wrangler.jsonc",
    "build": "wrangler deploy --dry-run --no-autoconfig -c wrangler.jsonc --outdir .wrangler/dry-run",
    "test": "node --test",
